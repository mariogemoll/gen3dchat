{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-11",
	"compatibility_flags": [
		"global_fetch_strictly_public",
        "nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"DAILY_LLM_CALL_LIMIT": "3",
		"JSCAD_VALIDATION_SERVICE_URL": "https://validation.gen3d.chat/api/validate",
		"SQIDS_CHECKPOINT_ALPHABET": "{{.SQIDS_CHECKPOINT_ALPHABET}}",
		"SQIDS_THREAD_ALPHABET": "{{.SQIDS_THREAD_ALPHABET}}"
	},
	"kv_namespaces": [
		{
			"binding": "HISTORY",
			"id": "{{.KV_NAMESPACE_ID}}"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "{{.D1_DATABASE_ID}}"
		}
	]
}
