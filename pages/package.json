{
  "name": "gen3dchat",
  "scripts": {
    "dev": "concurrently \"wrangler pages dev --port 8788\" \"npm run dev:front\"",
    "dev:front": "npm --prefix frontend0 run dev",
    "build": "npm --prefix frontend0 run build",
    "deploy": "npm run build && wrangler pages deploy frontend0/dist"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.9.3",
    "wrangler": "^3.80.0"
  },
  "dependencies": {
    "@langchain/core": "^1.0.3",
    "@langchain/langgraph": "^1.0.1",
    "@langchain/langgraph-checkpoint": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "hono": "^4.6.0",
    "langsmith": "^0.3.79",
    "openai": "^6.8.1",
    "sqids": "^0.3.0"
  }
}
